# LD19 F407VE standalone bench board - CubeMX source configuration
# This file documents the exact pins/clocks used by the hand-written BSP.
# The firmware initialisation in Core/BSP is kept consistent with this file;
# it is NOT generated by CubeMX at build time (the CMake/Ninja build is the
# reproducible source of truth).

Mcu.Name=STM32F407V(E-G)Tx
Mcu.UserName=STM32F407VETx
Mcu.Package=LQFP100
Mcu.Family=STM32F4

# Board identity
Board.Profile=f407ve_ld19_bench
Board.HSE=25 MHz crystal (HSE_VALUE=25000000)
Board.Note=PC13 is W25Q128 chip-select ONLY (never LED); PB6/PB7 are I2C1 ONLY;
Board.Note2=no vehicle motor/servo/IMU outputs are initialised by this firmware.

# Clocks: HSE25 / PLLM25 / PLLN336 / PLLP2 / PLLQ7 -> 168 MHz
RCC.PLLSourceVirtual=RCC_PLLSOURCE_HSE
RCC.PLLM=25
RCC.PLLN=336
RCC.PLLP=RCC_PLLP_DIV2
RCC.PLLQ=7
RCC.SYSCLKSource=RCC_SYSCLKSOURCE_PLLCLK
RCC.AHBCLKDivider=RCC_SYSCLK_DIV1
RCC.APB1CLKDivider=RCC_HCLK_DIV4
RCC.APB2CLKDivider=RCC_HCLK_DIV2
RCC.VDDVoltageScale=PWR_REGULATOR_VOLTAGE_SCALE1
RCC.FLASHLatency=FLASH_LATENCY_5

# Pins
PA3.Signal=USART2_RX
PA3.Mode=Alternate Function Push Pull
PA3.Pull=Pull-up
PA5.Signal=SPI1_SCK
PA6.Signal=SPI1_MISO
PA7.Signal=SPI1_MOSI
PA9.Signal=USART1_TX
PA10.Signal=USART1_RX
PA13.Signal=SYS_JTMS-SWDIO
PA14.Signal=SYS_JTCK-SWCLK
PB6.Signal=I2C1_SCL
PB7.Signal=I2C1_SDA
PB6.Mode=Alternate Function Open Drain
PB7.Mode=Alternate Function Open Drain
PB6.Pull=Pull-up (external 3.3V pull-ups already fitted)
PB7.Pull=Pull-up (external 3.3V pull-ups already fitted)
PC13.Signal=GPIO_Output
PC13.Mode=Output Push Pull
PC13.InitialLevel=High
PC13.Role=W25Q_CS_ONLY_NOT_LED
PB8.Signal=GPIO_Output (optional TIM4_CH3 lidar speed PWM - NOT initialised, reserved)
PD8.Signal=NOT_USED
PD9.Signal=NOT_USED

# Peripherals
USART1.Mode=Asynchronous
USART1.BaudRate=460800
USART1.WordLength=8
USART1.Parity=None
USART1.StopBits=1
USART1.TX=PA9
USART1.RX=PA10
USART1.TX_DMA=DMA2_Stream7/Channel4
USART1.RX_Mode=Interrupt (small command ring; not the bulk lidar path)
USART1.NVIC_Priority=2

USART2.Mode=Asynchronous (RX only)
USART2.BaudRate=230400
USART2.WordLength=8
USART2.Parity=None
USART2.StopBits=1
USART2.RX=PA3
USART2.RX_DMA=DMA1_Stream5/Channel4/Circular
USART2.RX_Buffer=4096 bytes (ordinary SRAM, never CCM)
USART2.NVIC_Priority=1

TIM2.Mode=Base (free running)
TIM2.Prescaler=83 (84 MHz APB1 timer / 84 = 1 MHz)
TIM2.Period=0xFFFFFFFF
TIM2.Counter=32 bit up
TIM2.Role=MCU microsecond timestamp (wraps ~71.6 min; unsigned diff)

SPI1.Mode=Full-Duplex Master
SPI1.Prescaler=SPI_BAUDRATEPRESCALER_64
SPI1.CLKPhase=1Edge
SPI1.CLKPolarity=Low
SPI1.NSS=Software (PC13)
SPI1.Role=W25Q128 JEDEC read-only diagnostics

I2C1.Mode=I2C
I2C1.Speed=100000
I2C1.AddressingMode=7-bit
I2C1.Role=24C02 (address 0x50) read-only diagnostics

NVIC.PriorityGroup=NVIC_PRIORITYGROUP_4

# Unused / must stay uninitialised: TIM1, TIM3, TIM4, TIM8, all ADC, CAN, USB,
# FSMC, SDIO, ETH and every motor/servo/IMU-related GPIO group.
Unused.VehicleOutputs=NOT_INITIALISED
Unused.PB8_LidarPWM=DISABLED_PHASE1
